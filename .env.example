# ==================================================
# EVENTDHARA AI OPERATIONS PLATFORM CONFIGURATION
# ==================================================

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql+psycopg2://postgres:123456@localhost:5432/eventdhara_db
SQL_ECHO=False

# Application Environment
ENVIRONMENT=development
APP_NAME="EventDhara AI Data Operations Platform"
API_V1_STR=/api/v1
SECRET_KEY=eventdhara-enterprise-secure-key-2026

# Storage Settings
STORAGE_ROOT=../storage
MAX_UPLOAD_SIZE_MB=500

# Image Quality & Processing Parameters
MIN_IMAGE_WIDTH=800
MIN_IMAGE_HEIGHT=600
MIN_FILE_SIZE_KB=50
BLUR_THRESHOLD=100.0
PHASH_THRESHOLD=5
WATERMARK_DETECTION=False

# Google Gemini AI Settings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_CONFIDENCE_THRESHOLD=0.75

# Google Drive Cloud Integration
GOOGLE_DRIVE_ROOT_FOLDER_NAME="EventDhara Decoration Images"
GOOGLE_SERVICE_ACCOUNT_JSON=

# Allowed CORS Origins
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
